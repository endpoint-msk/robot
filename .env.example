# --- Обязательные ---
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_here

# Чаты, где бот работает (через запятую). В остальных — молчит.
ALLOWED_CHATS=-1001234567890

# --- Опциональные ---

# Файл стейта и файл сессии mtcute.
# В Docker оба обязаны лежать в примонтированном томе (/app/bot-data/...), иначе
# пересборка образа стирает их вместе со слоем. В docker-compose.yaml это уже задано
# через environment и значения отсюда там не действуют.
DATA_FILE=./data.json
SESSION_FILE=./bot.session

# Форвардинг постов из канала в чат (нужны обе переменные).
FORWARD_FROM_CHAT=
FORWARD_TO_CHAT=

# Чат, где бот банит входящих и чистит служебные сообщения.
LIVE_CHAT_ID=

# Чат резидентов: его участники и есть резиденты спейса (боты не в счёт). Отсюда
# берутся права на всё резидентское (миниапп, присутствие, принтер) и список
# плательщиков взносов. Бот должен быть админом этого чата, иначе Telegram не отдаст
# ему список участников.
# Пусто — откат на прежнее правило «резидент = админ любого чата из ALLOWED_CHATS».
RESIDENTS_CHAT_ID=

# Канал анонсов. Пересланный оттуда в личку пост бот предлагает резиденту превратить
# в ивент (текст и афиша подтягиваются). Пусто — поток выключен, ивенты заводятся
# только вручную из миниаппа.
ANNOUNCE_CHANNEL_ID=

# Чат спейса и лайв-канал: в них (и в канале анонсов) dev выдаёт резиденту админку из
# миниаппа, в чате ещё и тег «resident». На выходе из чата резидентов бот это снимает.
# Бот должен быть там админом с правом добавлять админов, в чате и менять теги.
MAIN_CHAT_ID=
LIVE_CHANNEL_ID=

# --- Аккаунты резидентов в Authentik ---
# Вступил в чат резидентов - бот заводит аккаунт с логином-ником из Telegram (без ника -
# tg<id>) и атрибутом telegram_id в группе AUTHENTIK_GROUP. Вышел - выключает его (сессии
# и OAuth-токены Authentik при этом снимает сам, вики выкидывает на следующем открытии) и
# забирает группу. Пусто - аккаунты не ведутся.
# Токен - API-токен сервисного аккаунта: просмотр, создание, изменение и удаление
# пользователей, просмотр групп, добавление и удаление участников группы AUTHENTIK_GROUP.
# У Telegram-источника в Authentik: User matching mode «Link to a user with identical
# username» и маппинг свойств пользователя:
#   tid = info.get("id")
#   owner = (ak_user_by(attributes__telegram_id=str(tid)) or ak_user_by(attributes__telegram_id=tid)) if tid else None
#   return {"username": owner.username if owner else None}
# Маппинг ищет аккаунт по подписанному Telegram id, а не по нику: ник переходит к другому
# человеку. Нет такого аккаунта - None, и Authentik отказывает во входе: без аккаунта от
# бота через Telegram больше не зарегистрироваться. Вход по уже привязанному Telegram
# (старые аккаунты) это не трогает.
AUTHENTIK_URL=https://auth.endpoint.moscow
AUTHENTIK_TOKEN=
# Имя группы буква в букву: Authentik сравнивает его с учётом регистра.
AUTHENTIK_GROUP=Residents
# Почта новых аккаунтов - <логин>@домен: без email Outline не пускает, а Telegram его не отдаёт.
AUTHENTIK_EMAIL_DOMAIN=endpoint.moscow

# 3D-принтер (Moonraker). Пусто — команда /printer выключена.
PRINTER_URL=http://192.168.2.40/
# Basic-авторизация к принтеру в формате user:pass.
PRINTER_AUTH=

# Роутер Keenetic для авто-отметок по MAC (нужны URL/LOGIN/PASSWORD).
KEENETIC_URL=http://192.168.1.1/
KEENETIC_LOGIN=admin
KEENETIC_PASSWORD=
# RCI-команда со списком хостов (по умолчанию show/ip/hotspot).
KEENETIC_RCI_PATH=show/ip/hotspot

# userId (через запятую) дев-аккаунтов: отладочные команды (/forcemacupdate),
# отчёты об ошибках в личку и дев-меню миниаппа (переключатель перспективы
# «резидент ↔ гость» + создание фейковых заявок).
DEV_USER_IDS=

# --- Миниапп хостинга гостей ---
# Публичный HTTPS-адрес миниаппа. Пусто — вся подсистема хостинга выключена.
# Тот же URL укажи в BotFather (/mybots → Bot Settings → Configure Mini App →
# Enable Mini App), чтобы работали кнопки-ссылки t.me/<bot>?startapp в группах.
# Кнопку меню рядом с полем ввода бот ставит сам через API.
WEBAPP_URL=
# Хост/порт HTTP-сервера миниаппа (обычно за реверс-прокси с TLS).
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Имя контейнера в docker-сети public, по которому его находит caddy. Нужно только
# на дев-стенде, живущем на одном хосте с продом: задай endpoint-webapp-dev и заведи
# в caddy отдельный маршрут (напр. dev.visit... → endpoint-webapp-dev:8080). На проде
# оставь пустым — compose подставит дефолт endpoint-webapp.
WEBAPP_HOSTNAME=
# Смещение пояса спейса от UTC в минутах — задаёт границы «дней» хостинга
# и понятие «сегодня» для уведомлений (180 = Москва).
HOSTING_TZ_OFFSET_MINUTES=180

# --- Анонсы версий ---
# Публичный GitHub-репо 'owner/name' — из него дев-меню миниаппа тянет описание
# последнего релиза для анонса «Бот обновлён до версии …». По умолчанию репо проекта.
GITHUB_REPO=endpoint-msk/robot
